SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_SECRET_KEY=server-only-secret-key
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_STUDIO_ID=00000000-0000-0000-0000-000000000001
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GOOGLE_API_KEY=
# Google Drive credentials. The first one set wins.
#
#   B64  - recommended for production. One line, no newline mangling, works on
#          any host that only offers plain env vars:
#            base64 -i service-account.json | tr -d '\n'
#   JSON - the raw JSON, for hosts that handle multiline secrets cleanly.
#   FILE - a path; good for local dev and for mounted secrets (Cloud Run, k8s).
#
# Never commit the key. If you deploy on GCP, prefer attaching the service
# account to the runtime and dropping all three.
GOOGLE_SERVICE_ACCOUNT_B64=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
API_ENV=development
